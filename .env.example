DATABASE_URL=postgresql://user:password@host/database?sslmode=require
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_example

# Optional accounts use the existing DATABASE_URL. No external auth service is required.
# For a custom domain, set its exact origin. Local development defaults to port 3000.
# BETTER_AUTH_URL=https://fate-gameplay-toolkit.vercel.app
# Optional: a stable random secret of at least 32 characters. If omitted, one is
# generated once and stored privately in fate_app_config. Keep it stable afterwards.
# BETTER_AUTH_SECRET=
